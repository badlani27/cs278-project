# Copy to .env at repo root for local development

# PostgreSQL — use Session pooler on IPv4 networks (most laptops / campus Wi‑Fi).
# Supabase Dashboard → Project → Connect → copy "Session pooler" URI (port 5432).
# Replace YOUR_PROJECT_REF, YOUR_PASSWORD, and aws-0-REGION with values from that modal.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct connection (IPv6-only on free tier — often fails locally with Prisma P1001):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Public URL of the React app (OAuth redirect landing + CORS)
CLIENT_URL="http://127.0.0.1:5173"

# Backend base URL (used by the API for redirects / absolute links)
API_URL="http://127.0.0.1:4000"

# Browser → API origin (must match where the Express app listens)
VITE_API_URL="http://127.0.0.1:4000"

# Spotify app credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Must match exactly what you register in Spotify Dashboard (API server callback)
SPOTIFY_REDIRECT_URI="http://127.0.0.1:4000/auth/spotify/callback"

# Session signing secret (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"
