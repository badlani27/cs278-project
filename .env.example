# Copy to .env at repo root for local development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soundboard?schema=public"

# Public URL of the React app (OAuth redirect landing + CORS)
CLIENT_URL="http://localhost:5173"

# Backend base URL (used by the API for redirects / absolute links)
API_URL="http://localhost:4000"

# Browser → API origin (must match where the Express app listens)
VITE_API_URL="http://localhost:4000"

# Spotify app credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Must match exactly what you register in Spotify Dashboard (API server callback)
SPOTIFY_REDIRECT_URI="http://localhost:4000/auth/spotify/callback"

# Session signing secret (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"
